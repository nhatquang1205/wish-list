# Postgres connection string. Hosted Postgres needs sslmode=require:
#   postgresql://user:password@host:5432/wishlist?sslmode=require
# Leave unset in local dev to use the in-memory store.
DATABASE_URL=

# Nina's code — she can add, edit and remove wishes.
NINA_CODE=011101

# Admin code — can only move a wish between statuses.
ADMIN_CODE=220826

# Key used to sign the auth cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me

# Optional. Defaults to "Nina's Little Wish List".
WISHLIST_TITLE=

# Backblaze B2 for wish photos, via its S3-compatible API. Create an
# application key scoped to one PUBLIC bucket and paste the pair here.
# Leave unset and the photo picker reports that storage isn't set up.
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APP_KEY=
# Optional overrides. Region is read from the endpoint, and the public base
# defaults to https://<bucket>.s3.<region>.backblazeb2.com — set it if you put
# a CDN or custom domain in front of the bucket.
B2_REGION=
B2_PUBLIC_BASE_URL=
