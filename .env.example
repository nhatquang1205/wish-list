# Postgres connection string. Hosted Postgres needs sslmode=require:
#   postgresql://user:password@host:5432/wishlist?sslmode=require
# Leave unset in local dev to use the in-memory store.
DATABASE_URL=

# Nina's code — she can add, edit and remove wishes.
NINA_CODE=011101

# Admin code — can only move a wish between statuses.
ADMIN_CODE=220826

# Key used to sign the auth cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me

# Optional. Defaults to "Nina's Little Wish List".
WISHLIST_TITLE=
